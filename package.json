{
  "name": "tyflow-studio",
  "productName": "TingYun Studio",
  "version": "0.2.1",
  "description": "OpenDesign to development desktop workspace",
  "author": "TingYun Studio",
  "private": true,
  "main": "dist/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/build.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "jest --runInBand",
    "scan": "node scripts/scan.cjs",
    "start": "electron .",
    "pack": "npm run build && electron-builder --dir",
    "pack:portable": "node scripts/pack-portable.cjs",
    "pack:portable:win": "node scripts/pack-portable.cjs --win",
    "pack:portable:mac": "node scripts/pack-portable.cjs --mac",
    "pack:portable:seed": "node scripts/pack-portable.cjs --prepare-only --seed",
    "dist:win": "npm run build && electron-builder --win nsis --x64",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --x64"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yauzl": "^3.2.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "44.4.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "6.4.3"
  },
  "build": {
    "appId": "com.tyflow.studio",
    "productName": "TingYun Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": "nsis",
      "artifactName": "TingYun-Studio-${version}-Windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "TingYun-Studio-${version}-macOS-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "UNLICENSED"
}
